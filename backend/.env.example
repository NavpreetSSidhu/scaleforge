PORT=8080
DATABASE_URL=postgres://scaleforge:scaleforge@localhost:5432/scaleforge?sslmode=disable
CORS_ORIGIN=http://localhost:5173
GIN_MODE=debug
DEV_USER_ID=00000000-0000-0000-0000-000000000001
# Secret used to sign JWTs (HS256). Use a long random value in production.
JWT_SECRET=dev-insecure-secret-change-me
# AI assistant (optional). Set a Groq API key (free tier: https://console.groq.com)
# to enable the architecture assistant. Leave empty to disable the feature.
GROQ_API_KEY=
# Override the LLM model shared by every AI feature (defaults to
# openai/gpt-oss-120b). Groq retires models on a rolling basis, and a retired
# default fails every AI feature at once with a "not available" error — set this
# to any model your account can reach:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
ASSIST_MODEL=
# Real Sandbox (optional). Stands the design up as a live HTTP service and
# load-tests it. Set to 1 to enable; it spawns a server and drives real traffic.
SANDBOX_ENABLED=
# Labs (optional). Starts real containers — MinIO, k3s, Postgres, Redis — on an
# isolated Docker network and attaches a browser terminal to them. Set to 1 to
# enable. Requires a reachable Docker daemon.
LABS_ENABLED=
